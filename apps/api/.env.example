APP_NAME=EnviRescue API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/envirescue
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
AI_MODEL_NAME=
AI_CONFIDENCE_THRESHOLD=0.80
AI_PROVIDER=fallback
AI_CLASSIFIER_URL=
HF_API_TOKEN=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RECOVERY_SECONDS=30
FRONTEND_URL=http://localhost:3000
# Optional JSON list, for example ["https://app.example.com"]
CORS_ORIGINS=[]
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_PATH=uploads
MAX_IMAGE_SIZE_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=envirescue/waste
